<article class="application-row">
  <div class="company-avatar" aria-hidden="true"><%= initials(job_application.company.name) %></div>
  <div class="application-main">
    <%= link_to job_application.role_title, job_application, class: "application-title" %>
    <span class="application-company"><%= job_application.company.name %> · <%= job_application.location.presence || "Location flexible" %></span>
  </div>
  <div class="application-meta">
    <div class="application-badges">
      <%= render "shared/status_badge", status: job_application.status %>
      <% if job_application.stale? %><span class="attention-pill">Needs update</span><% end %>
    </div>
    <% if job_application.follow_up_on %><span class="muted <%= "text-danger" if job_application.overdue? %>">Follow-up: <%= follow_up_label(job_application) %></span><% end %>
    <span class="muted">Updated <%= time_ago_in_words(job_application.updated_at) %> ago</span>
  </div>
</article>

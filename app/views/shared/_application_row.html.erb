<article class="application-row">
  <div class="company-avatar" aria-hidden="true"><%= initials(job_application.company.name) %></div>
  <div class="application-main">
    <%= link_to job_application.role_title, job_application, class: "application-title" %>
    <span class="application-company"><%= job_application.company.name %> · <%= job_application.location.presence || "Location flexible" %></span>
  </div>
  <div class="application-meta">
    <span class="status-pill status-pill--<%= job_application.status %>"><%= status_label(job_application.status) %></span>
    <span class="muted"><%= job_application.follow_up_on ? "Follow up #{formatted_date(job_application.follow_up_on)}" : "Updated #{time_ago_in_words(job_application.updated_at)} ago" %></span>
  </div>
</article>

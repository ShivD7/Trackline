<% page_title "Pipeline" %>

<section class="page-header">
  <div>

    <h1>Pipeline</h1>
    <p>Scan every opportunity by its current stage.</p>
  </div>
  <%= link_to "Add application", new_job_application_path, class: "button" %>
</section>

<nav class="pipeline-jump" aria-label="Jump to pipeline stage"><% JobApplication::STATUSES.each do |status| %><%= link_to status_label(status), "#stage-#{status}", class: "filter-chip" %><% end %></nav>
<section class="pipeline-board" aria-label="Application pipeline" tabindex="0">
  <% JobApplication::STATUSES.each do |status| %>
    <% applications = @applications_by_status.fetch(status, []) %>
    <div class="pipeline-column" id="stage-<%= status %>">
      <header>
        <span class="pipeline-dot pipeline-dot--<%= status %>"></span>
        <h2><%= status_label(status) %></h2>
        <span class="count-badge"><%= applications.size %></span>
      </header>
      <div class="pipeline-cards">
        <% applications.each do |application| %>
          <%= render "shared/pipeline_application", application: application %>
        <% end %>
        <% if applications.empty? %>
          <p class="pipeline-empty">No applications</p>
        <% end %>
      </div>
    </div>
  <% end %>
</section>

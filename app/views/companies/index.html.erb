<% page_title "Companies" %>
<section class="page-header">
  <div><span class="eyebrow">Research shelf</span><h1>Companies</h1><p>Keep the organizations in your search easy to revisit.</p></div>
  <%= link_to "Add company", new_company_path, class: "button" %>
</section>

<%= form_with url: companies_path, method: :get, class: "filter-bar filter-bar--compact" do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: "Search name, industry, or location", class: "search-input", "aria-label": "Search companies" %>
  <%= form.submit "Search", class: "button button--secondary" %>
  <% if params[:q].present? %><%= link_to "Clear", companies_path, class: "text-link" %><% end %>
<% end %>

<section class="company-grid">
  <% @companies.each do |company| %>
    <%= link_to company, class: "company-card" do %>
      <div class="company-avatar company-avatar--large"><%= initials(company.name) %></div>
      <div><h2><%= company.name %></h2><p><%= company.industry.presence || "Industry not set" %></p></div>
      <span><%= pluralize(company.applications_count, "application") %> →</span>
    <% end %>
  <% end %>
  <% if @companies.empty? %>
    <div class="empty-state content-card"><strong><%= params[:q].present? ? "No companies match that search." : "No companies yet." %></strong><p><%= params[:q].present? ? "Try a company name, industry, or city." : "Companies are also created automatically when you add an application." %></p></div>
  <% end %>
</section>

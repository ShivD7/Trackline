<% page_title @company.name %>
<section class="record-hero">
  <div class="record-identity"><div class="company-avatar company-avatar--large"><%= initials(@company.name) %></div><div><span class="eyebrow"><%= @company.industry.presence || "Company" %></span><h1><%= @company.name %></h1><div class="hero-meta"><span><%= @company.headquarters.presence || "Headquarters not set" %></span></div></div></div>
  <div class="header-actions"><% if (website_url = safe_external_url(@company.website)) %><%= link_to "Visit website ↗", website_url, target: "_blank", rel: "noopener", class: "button button--secondary" %><% end %><%= link_to "Edit", edit_company_path(@company), class: "button" %></div>
</section>
<section class="content-card">
  <div class="section-heading"><div><span class="eyebrow">Pipeline</span><h2><%= pluralize(@job_applications.count, "application") %></h2></div><%= link_to "Add role", new_job_application_path, class: "text-link" %></div>
  <% if @job_applications.any? %><div class="application-list"><%= render partial: "shared/application_row", collection: @job_applications, as: :job_application %></div><% else %><div class="empty-state"><p>No applications at this company yet.</p></div><% end %>
</section>
<div class="destructive-zone"><%= button_to "Delete company", @company, method: :delete, class: "danger-link", form: { data: { turbo_confirm: "Delete this company?" } } %></div>

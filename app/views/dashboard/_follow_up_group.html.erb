<section class="content-card follow-up-section follow-up-section--<%= tone %>">
  <div class="section-heading">
    <h2><%= title %></h2>
    <span class="count-badge"><%= applications.size %></span>
  </div>

  <% if applications.any? %>
    <div class="application-list application-list--roomy">
      <% applications.each do |application| %>
        <div class="follow-up-row">
          <%= render "shared/application_row", job_application: application %>
          <%= button_to "Done", complete_follow_up_job_application_path(application), method: :patch, class: "button button--small button--secondary", form: { data: { turbo_confirm: "Mark this follow-up complete?" } } %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state empty-state--compact"><p><%= empty_message %></p></div>
  <% end %>
</section>

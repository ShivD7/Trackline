<% page_title "Overview" %>
<section class="page-header page-header--dashboard">
  <div><h1>Good <%= Time.current.hour < 12 ? "morning" : Time.current.hour < 18 ? "afternoon" : "evening" %>.</h1><p>Here’s what needs your attention today.</p></div>
  <%= link_to "Add application", new_job_application_path, class: "button" %>
</section>

<section class="content-card attention-card" aria-labelledby="attention-heading">
  <div class="section-heading"><div><h2 id="attention-heading">Your next steps</h2><p>Follow-ups to keep your conversations moving.</p></div><%= link_to "All follow-ups", follow_ups_path, class: "text-link" %></div>
  <nav class="attention-summary" aria-label="Follow-up timing">
    <%= link_to job_applications_path(follow_up: "overdue"), class: class_names("attention-summary-item", "attention-summary-item--overdue": @overdue_count.positive?) do %><strong><%= @overdue_count %></strong> Overdue<% end %>
    <%= link_to job_applications_path(follow_up: "today"), class: "attention-summary-item" do %><strong><%= @today_count %></strong> Due today<% end %>
    <%= link_to job_applications_path(follow_up: "upcoming"), class: "attention-summary-item" do %><strong><%= @upcoming_count %></strong> Next 14 days<% end %>
  </nav>
  <% if @follow_ups.any? %>
    <div class="attention-list"><%= render partial: "shared/follow_up_item", collection: @follow_ups, as: :application %></div>
  <% else %>
    <div class="empty-state empty-state--compact"><strong>You’re all caught up.</strong><p>No overdue or upcoming follow-ups in the next two weeks. Set a date on an active application to plan your next step.</p></div>
  <% end %>
</section>

<section class="metric-grid" aria-label="Application summary">
  <article class="metric-card"><span>Active applications</span><strong><%= @active_applications %></strong><small><%= pluralize(@total_applications, "application") %> total</small></article>
  <article class="metric-card"><span>Response rate</span><strong><%= @response_rate %>%</strong><small>Based on current stages <a href="#response-definition" class="metric-help">Definition</a></small></article>
  <article class="metric-card"><span>Offers</span><strong><%= @offers %></strong><small>In your current pipeline</small></article>
  <article class="metric-card <%= "metric-card--warning" if @overdue_count.positive? %>"><span>Overdue follow-ups</span><strong><%= @overdue_count %></strong><small><%= link_to "Review follow-ups", job_applications_path(follow_up: "overdue") %></small></article>
  <article class="metric-card"><span>Moves this week</span><strong><%= @stage_moves_this_week %></strong><small>Stage updates in the last 7 days</small></article>
</section>

<div class="dashboard-grid">
  <section class="content-card">
    <div class="section-heading"><h2>Recent applications</h2><%= link_to "View all", job_applications_path, class: "text-link" %></div>
    <% if @recent_applications.any? %>
      <div class="application-list"><%= render partial: "shared/application_row", collection: @recent_applications, as: :job_application %></div>
    <% else %>
      <div class="empty-state"><strong>Your pipeline starts here.</strong><p>Add a role you’re considering and Trackline will keep the details organized.</p><%= link_to "Add your first application", new_job_application_path, class: "text-link" %></div>
    <% end %>
  </section>
  <section class="content-card">
    <div class="section-heading"><h2>Active pipeline</h2><%= link_to "Open board", pipeline_job_applications_path, class: "text-link" %></div>
    <div class="pipeline-summary">
      <% JobApplication::STATUSES.first(5).each do |status| %>
        <%= link_to job_applications_path(status: status), class: "pipeline-stage" do %><span class="pipeline-dot pipeline-dot--<%= status %>" aria-hidden="true"></span><span><%= status_label(status) %></span><strong><%= @status_counts.fetch(status, 0) %></strong><% end %>
      <% end %>
    </div>
    <p class="section-note">Wishlist and active stages. The board includes rejected and withdrawn applications.</p>
  </section>
</div>

<section class="content-card analytics-section" id="search-activity" aria-labelledby="activity-heading" tabindex="-1">
  <div class="section-heading"><div><h2 id="activity-heading">Application activity</h2><p>Applications by the date you applied, over the last four weeks.</p></div></div>
  <% highest_count = [@weekly_activity.map(&:last).max, 1].max %>
  <div class="activity-chart" role="list" aria-label="Weekly application counts">
    <% @weekly_activity.each do |week, count| %>
      <div class="activity-row" role="listitem"><span>Week of <%= week.strftime("%b %-d") %></span><span class="activity-track" aria-hidden="true"><span style="width: <%= (count.to_f / highest_count * 100).round %>%"></span></span><strong><%= count %><span class="sr-only"> <%= "application".pluralize(count) %></span></strong></div>
    <% end %>
  </div>
  <p class="section-note" id="response-definition"><strong>Response rate:</strong> applications currently in screening, interviewing, offer, or rejected, divided by all applications outside Wishlist. This reflects saved stages, rather than a recorded reply from an employer.</p>
</section>
